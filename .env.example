# ========================================================
# KONFIGURASI ENVIRONMENT - LAPORSARPRAS AI UMY
# ========================================================

# Port Aplikasi (Di Cloud seperti Render/Railway, ini otomatis diatur oleh platform via PORT)
PORT=3000
APP_PORT=3000
NODE_ENV=production

# Kunci Rahasia Sesi Login (Ganti dengan string acak aman saat production)
SESSION_SECRET=laporsarpras_secret_key_production_2026

# ========================================================
# BASIS DATA POSTGRESQL
# ========================================================
# OPSI A: Jika menggunakan Cloud Database (Render, Supabase, Neon, Railway)
# Cukup isi DATABASE_URL, variabel individual di bawah tidak perlu diisi.
# Contoh: postgres://user:password@ep-cool-db.us-east-2.aws.neon.tech/laporsarpras_db?sslmode=require
DATABASE_URL=

# OPSI B: Jika menggunakan Local / VPS PostgreSQL Mandiri
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password_db
DB_NAME=laporsarpras_db
DB_DIALECT=postgres

# ========================================================
# GOOGLE GEMINI AI (OPSIONAL - Fallback Otomatis Aktif Jika Kosong)
# ========================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
